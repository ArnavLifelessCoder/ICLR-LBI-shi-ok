% iclr2026_conference.sty
%
% UNOFFICIAL drafting approximation of the ICLR conference style.
%
% This is NOT the official ICLR template. It reproduces the ICLR look closely
% enough to draft and review against (Times, ~5.5in x 9in text block, centered
% bold title, small-caps ABSTRACT heading, numbered sections, review line
% numbers), but exact margins, headers, and compliance must come from the
% official package. Before submitting, download the official ICLR template for
% the target year (e.g. iclr2027_conference.sty and its dependencies) and
% replace this file. Do not submit against this approximation.
%
% Provides: \iclrfinalcopy (turns off review line numbers), and restyled
% \maketitle / abstract / sections that work with the standard article
% \title, \author, \begin{abstract} already in paper.tex.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iclr2026_conference}[2026/01/01 Unofficial ICLR-style drafting layout]

\RequirePackage{geometry}
\RequirePackage{times}
\RequirePackage{fancyhdr}
\RequirePackage{lineno}

% --- Page geometry: ICLR-like text block on US letter ---
\geometry{
  letterpaper,
  textwidth=5.5in,
  textheight=9.0in,
  top=1.0in,
  left=1.5in,
  headheight=14pt,
  headsep=20pt,
  footskip=24pt
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip plus 2pt minus 1pt}

% --- Review vs final ---
\newif\ifusefinal
\usefinalfalse
\newcommand{\iclrfinalcopy}{\usefinaltrue}

\AtBeginDocument{%
  \ifusefinal\else
    \linenumbers
  \fi
}

% --- Header / footer: plain page numbers, unobtrusive ---
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}

% --- Title block ---
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \begin{center}
      {\LARGE\bfseries \@title \par}
      \vskip 1.2em
      {\normalsize \@author \par}
    \end{center}
  \endgroup
  \vskip 1.0em
}

% --- Abstract: narrower, small-caps centered heading (ICLR style) ---
\renewenvironment{abstract}{%
  \centerline{\normalsize\scshape Abstract}%
  \vspace{0.4em}%
  \begin{quote}\small
}{%
  \end{quote}\vspace{0.6em}
}

% --- Section headings: bold, ICLR-like sizing ---
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.2em}{0.5em}
\titlespacing*{\subsection}{0pt}{0.9em}{0.3em}

\endinput
